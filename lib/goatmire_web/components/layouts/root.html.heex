<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>{assigns[:page_title] || "Goatmire 2026"}</.live_title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href={~p"/assets/dashboard.css"} />
    <script defer src={~p"/vendor/phoenix_html.js"}>
    </script>
    <script defer src={~p"/vendor/phoenix.min.js"}>
    </script>
    <script defer src={~p"/vendor/phoenix_live_view.min.js"}>
    </script>
    <script type="module" src={~p"/vendor/app.js"}>
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="top">
      <div class="header-inner">
        <.link navigate={~p"/warehouse"} class="brand">
          <span class="brand-mark">GM</span>
          <span>Goatmire lab</span>
        </.link>
        <nav aria-label="Primary">
          <.link navigate={~p"/warehouse"}>Warehouse</.link>
          <.link navigate={~p"/rules"}>Rule gate</.link>
          <.link navigate={~p"/verify"}>Verifier</.link>
          <.link navigate={~p"/diagnostics"}>Diagnostics</.link>
          <.link navigate={~p"/notebook"}>Notebook</.link>
          <.link navigate={~p"/metrics"}>Metrics</.link>
          <.link navigate={~p"/talk"}>Talk</.link>
        </nav>
        <div class="service-links" aria-label="Supporting tools">
          <a href="http://localhost:8080" target="_blank" rel="noreferrer">Livebook ↗</a>
        </div>
      </div>
    </header>
    {@inner_content}
  </body>
</html>
