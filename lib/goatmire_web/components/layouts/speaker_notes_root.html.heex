<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <.live_title>{assigns[:page_title] || "Speaker notes"}</.live_title>
    <link rel="icon" href="data:," />
    <link rel="manifest" href={~p"/speaker-notes.webmanifest"} />
    <link rel="stylesheet" href={~p"/assets/speaker-notes.css"} />
    <script defer src={~p"/vendor/phoenix_html.js"}></script>
    <script defer src={~p"/vendor/phoenix.min.js"}></script>
    <script defer src={~p"/vendor/phoenix_live_view.min.js"}></script>
    <script type="module" src={~p"/vendor/app.js"}></script>
  </head>
  <body class="speaker-notes-body">
    {@inner_content}
  </body>
</html>
